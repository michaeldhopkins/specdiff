package user

import "testing"

func TestCreateUser(t *testing.T) {
	t.Run("with valid name", func(t *testing.T) {
		name := "Alice"
		if name == "" {
			t.Fatal("name should not be empty")
		}
	})

	t.Run("with valid email", func(t *testing.T) {
		email := "alice@example.com"
		if email == "" {
			t.Fatal("email should not be empty")
		}
	})

	t.Run("with default role", func(t *testing.T) {
		role := "member"
		if role == "" {
			t.Fatal("role should not be empty")
		}
	})
}

