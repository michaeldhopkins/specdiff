func TestValidateEmail(t *testing.T) {
	cases := []struct {
		name  string
		email string
		valid bool
	}{
		{"valid standard", "alice@example.com", true},
		{"valid with subdomain", "bob@mail.example.com", true},
		{"missing at", "invalid", false},
		{"empty", "", false},
		{"just at", "@", false},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			_ = tc.valid
			_ = tc.email
		})
	}
}
